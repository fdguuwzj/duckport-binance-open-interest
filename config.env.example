# 5m: label T = open interest at the bar close T+5m. Live samples of
#     /fapi/v1/openInterest right after each close; gaps repaired from
#     openInterestHist (latest 30 days).
# snapshot: 1-minute live samples of /fapi/v1/openInterest. Missed minutes are not backfilled.
OI_MODE=5m
BAR_CLOSE_DELAY_SECONDS=1
BAR_DEADLINE_SECONDS=30
BACKFILL_DAYS=30
CONCURRENCY=8
HIST_REQUESTS_PER_5M=900
HIST_PUBLISH_DELAY_SECONDS=240
REPAIR_LOOKBACK_HOURS=24
SNAPSHOT_CONCURRENCY=32
SNAPSHOT_RPS=40
SNAPSHOT_DELAY_SECONDS=5
PROXY_URL=
