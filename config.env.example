# history: 5-minute openInterestHist, up to 30 days.
# snapshot: 1-minute live samples of /fapi/v1/openInterest. Missed minutes are not backfilled.
OI_MODE=history
BACKFILL_DAYS=30
CONCURRENCY=8
REQUEST_INTERVAL_SECONDS=0.34
POLL_DELAY_SECONDS=30
SNAPSHOT_CONCURRENCY=32
SNAPSHOT_RPS=40
SNAPSHOT_DELAY_SECONDS=5
PROXY_URL=
